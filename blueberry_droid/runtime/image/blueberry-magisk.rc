on post-fs-data
    start logd
    exec u:r:su:s0 root root -- /system/etc/blueberry-magisk/magiskpolicy --live --magisk
    exec u:r:su:s0 root root -- /system/etc/blueberry-magisk/magisk --auto-selinux --setup-sbin /system/etc/blueberry-magisk /sbin
    exec u:r:su:s0 root root -- /sbin/magisk --auto-selinux --post-fs-data

on nonencrypted
    exec u:r:su:s0 root root -- /sbin/magisk --auto-selinux --service

on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /sbin/magisk --auto-selinux --boot-complete
    exec u:r:su:s0 root root -- /system/bin/sh /system/etc/blueberry-magisk/install-manager.sh

on property:init.svc.zygote=restarting
    exec u:r:su:s0 root root -- /sbin/magisk --auto-selinux --zygote-restart
